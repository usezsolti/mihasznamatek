# env files (secrets) — a sablonok mehetnek a repóba
.env
.env.local
.env.*.local
!.env.local.example
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*

# local agent debug logs
debug-*.log
.cursor/


/prisma/*.db
/prisma/*.db-journal
*.db
*.db-journal
