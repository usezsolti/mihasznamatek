rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'usezsolti@gmail.com';
    }
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }
    function isBookingFile() {
      return request.resource.contentType.matches('image/.*')
        || request.resource.contentType == 'application/pdf'
        || request.resource.contentType == 'application/msword'
        || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document';
    }

    match /avatars/{userId}.jpg {
      allow read: if true;
      allow write: if signedIn()
        && request.auth.uid == userId
        && isImage()
        && request.resource.size < 8 * 1024 * 1024;
    }

    match /booking-files/{bookingId}/{fileName} {
      allow read: if isAdmin() || signedIn();
      // Vendég foglaláshoz is kellhet csatolmány — típus + méret korlát
      allow write: if isBookingFile()
        && request.resource.size < 8 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
