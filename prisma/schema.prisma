generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String    @default("student")
  educationLevel String?
  profile       String?
  gdprAccepted  Boolean   @default(false)
  gdprAcceptedAt DateTime?
  gdprVersion   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  socialProfile SocialProfile?
  bookings      Booking[]     @relation("CustomerBookings")
  assignedTasks AssignedTask[]
  gameResults   GameResult[]
  practiceProgress PracticeProgress?
  teacherNote   TeacherNote?
  teacherAdmin  String?
  createdLessonRooms LessonRoom[] @relation("LessonCreatedBy")
  callParticipants CallParticipant[]
  whiteboardStrokes WhiteboardStroke[]
  lessonMessages LessonMessage[]
  ownedWhiteboards Whiteboard[] @relation("WhiteboardOwner")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Booking {
  id              String   @id @default(cuid())
  date            String
  times           String   @default("[]")
  customerName    String
  customerEmail   String
  lessonType      String
  selectedSubject String   @default("")
  hobby           String   @default("")
  totalPrice      Int      @default(0)
  postalCode      String?
  street          String?
  houseNumber     String?
  uploadedFiles   String?
  submittedAt     DateTime @default(now())
  status          String   @default("pending")
  paymentStatus   String?
  paidAt          DateTime?
  reminderSentAt  DateTime?
  gdprAccepted    Boolean  @default(false)
  gdprAcceptedAt  DateTime?
  gdprVersion     String?
  userId          String?
  user            User?    @relation("CustomerBookings", fields: [userId], references: [id])

  @@index([date])
  @@index([customerEmail])
  @@index([status])
}

model BlockedSlot {
  id        String   @id @default(cuid())
  date      String   @unique
  times     String   @default("[]")
  allDay    Boolean  @default(false)
  note      String?
  updatedAt DateTime @updatedAt
}

model Setting {
  id    String @id
  value String @default("{}")
}

model AssignedTask {
  id           String   @id @default(cuid())
  studentId    String
  studentEmail String?
  title        String
  topicTitle   String?
  status       String   @default("assigned")
  payload      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  student      User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model CustomTask {
  id        String   @id @default(cuid())
  ownerId   String
  title     String
  payload   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model GameResult {
  id        String   @id @default(cuid())
  userId    String
  topicId   String?
  score     Int?
  payload   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PracticeProgress {
  userId    String   @id
  data      String   @default("{}")
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TeacherNote {
  studentId String   @id
  text      String   @default("")
  updatedAt DateTime @updatedAt
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model SocialProfile {
  uid         String   @id
  username    String   @unique
  displayName String   @default("")
  bio         String   @default("")
  photoURL    String?
  showXp      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [uid], references: [id], onDelete: Cascade)
  posts       SocialPost[]
  comments    SocialComment[]
  likes       SocialLike[]
  followers   Follow[] @relation("Following")
  following   Follow[] @relation("Follower")
  ownedGroups StudyGroup[] @relation("GroupOwner")
  groupMembers StudyGroupMember[]
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    SocialProfile @relation("Follower", fields: [followerId], references: [uid], onDelete: Cascade)
  following   SocialProfile @relation("Following", fields: [followingId], references: [uid], onDelete: Cascade)

  @@id([followerId, followingId])
}

model SocialPost {
  id        String   @id @default(cuid())
  authorId  String
  text      String
  imageUrl  String?
  videoUrl  String?
  createdAt DateTime @default(now())
  author    SocialProfile @relation(fields: [authorId], references: [uid], onDelete: Cascade)
  likes     SocialLike[]
  comments  SocialComment[]

  @@index([createdAt])
}

model SocialLike {
  postId String
  uid    String
  post   SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   SocialProfile @relation(fields: [uid], references: [uid], onDelete: Cascade)

  @@id([postId, uid])
}

model SocialComment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  text      String
  createdAt DateTime @default(now())
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    SocialProfile @relation(fields: [authorId], references: [uid], onDelete: Cascade)
}

model StudyGroup {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  topic       String   @default("")
  ownerId     String
  createdAt   DateTime @default(now())
  owner       SocialProfile @relation("GroupOwner", fields: [ownerId], references: [uid], onDelete: Cascade)
  members     StudyGroupMember[]
  messages    GroupMessage[]
}

model StudyGroupMember {
  groupId String
  uid     String
  group   StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  profile SocialProfile @relation(fields: [uid], references: [uid], onDelete: Cascade)

  @@id([groupId, uid])
}

model GroupMessage {
  id        String   @id @default(cuid())
  groupId   String
  senderId  String
  text      String
  createdAt DateTime @default(now())
  group     StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
}

model Conversation {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  updatedAt DateTime @updatedAt
  messages  DirectMessage[]

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model DirectMessage {
  id             String   @id @default(cuid())
  conversationId String
  fromUid        String
  toUid          String
  text           String
  createdAt      DateTime @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model MathShort {
  id        String   @id @default(cuid())
  title     String
  body      String
  payload   String?
  createdAt DateTime @default(now())
}

model LessonRoom {
  id            String   @id @default(cuid())
  title         String
  createdBy     String
  whiteboardId  String?
  bookingId     String?
  studentName   String?
  createdAtMs   BigInt
  createdAt     DateTime @default(now())
  creator       User     @relation("LessonCreatedBy", fields: [createdBy], references: [id])
  messages      LessonMessage[]
  participants  CallParticipant[]
  signals       CallSignal[]
}

model LessonMessage {
  id           String   @id @default(cuid())
  roomId       String
  senderId     String
  senderName   String
  senderPhoto  String   @default("")
  text         String
  createdAtMs  BigInt
  createdAt    DateTime @default(now())
  room         LessonRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender       User       @relation(fields: [senderId], references: [id])

  @@index([roomId, createdAtMs])
}

model CallParticipant {
  roomId           String
  uid              String
  displayName      String  @default("")
  role             String  @default("student")
  sharingScreen    Boolean @default(false)
  shareUpdatedAtMs BigInt?
  joinedAtMs       BigInt
  room             LessonRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user             User       @relation(fields: [uid], references: [id], onDelete: Cascade)

  @@id([roomId, uid])
}

model CallSignal {
  id          String @id @default(cuid())
  roomId      String
  type        String
  fromUid     String
  sdp         String?
  candidate   String?
  createdAtMs BigInt
  room        LessonRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAtMs])
}

model Whiteboard {
  id        String   @id @default(cuid())
  ownerId   String?
  title     String   @default("Tábla")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner     User?    @relation("WhiteboardOwner", fields: [ownerId], references: [id])
  strokes   WhiteboardStroke[]
}

model WhiteboardStroke {
  id          String   @id @default(cuid())
  boardId     String
  authorId    String?
  payload     String   @default("{}")
  createdAtMs BigInt
  createdAt   DateTime @default(now())
  board       Whiteboard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  author      User?      @relation(fields: [authorId], references: [id])

  @@index([boardId, createdAtMs])
}
