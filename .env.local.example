# ============================================================
# Éles + helyi env — lásd még: DEPLOY.md
# ============================================================
# Vercel: Settings → Environment Variables (ugyanazok).
# SOHA ne commitold a .env.local fájlt valódi jelszavakkal.

# --- Gmail SMTP (kötelező a megbízható foglalási e-mailekhez) ---
GMAIL_USER=your@gmail.com
GMAIL_APP_PASSWORD=

# --- Éles site URL (dashboard / e-mail linkek) ---
NEXT_PUBLIC_SITE_URL=https://mihasznamatek.hu

# --- Opcionális ---
# WEB3FORMS_ACCESS_KEY=
# OPENAI_API_KEY=
# Gemini (ingyenes AI Studio kulcs) — főoldali MihAIy chat
# https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_CHAT_MODEL=gemini-3.5-flash
# NEXT_PUBLIC_GOOGLE_API_KEY=
# CRON_SECRET=

# --- Backend / közösség ---
# local = fájl DB (data/social-local.json), firestore = éles Firestore rules kell
# SOCIAL_DATA_STORE=local
# NEXT_PUBLIC_SOCIAL_API_ONLY=1
# FIREBASE_PROJECT_ID=
# FIREBASE_WEB_API_KEY=
# Admin SDK (egysoros JSON) — diáklista/foglalás rules nélkül is megy a szerveren
# Firebase Console → Project settings → Service accounts → Generate new private key
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"mihasznamatek-c9701",...}
# ADMIN_EMAILS=usezsolti@gmail.com
# NEXT_PUBLIC_ADMIN_EMAILS=usezsolti@gmail.com
# ADMIN_LOGIN_EMAIL=usezsolti@gmail.com
# ADMIN_LOGIN_PASSWORD=
# ALLOW_DEV_ADMIN_FALLBACK=1
# ALLOW_ADMIN_PASSWORD_RELAY=1
# Admin belépő oldal: /admin-login
# ALLOW_DEBUG_INGEST=1
# ALLOW_RULES_EXPORT=1
# ALLOW_SOCIAL_DIAG=1
# ALLOW_HEALTH_DETAILS=1
# NEXT_PUBLIC_ALLOW_TEST_LOGIN=1
# TEST_LOGIN_EMAIL=teszt@mihasznamatek.hu
# TEST_LOGIN_PASSWORD=
# ALLOW_TEST_PASSWORD_RELAY=1
# ALLOWED_ORIGINS=

