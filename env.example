# Másold .env.local néven, és töltsd ki a saját értékeiddel.
# SOHA ne commitold a .env.local-t, és ne írj be valódi jelszót az example fájlba.

# Firebase (nyilvános kliens kulcsok — a védelmet a Firestore/Storage Rules adják)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Oldal URL (e-mail linkekhez — kötelező productionben)
NEXT_PUBLIC_SITE_URL=https://mihasznamatek.hu

# Gmail SMTP (App Password — NEM a fiók jelszava)
# https://myaccount.google.com/apppasswords
GMAIL_USER=your@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Opcionális fallback e-mail szolgáltató
# WEB3FORMS_ACCESS_KEY=

# OpenAI (játék / egyetemi feladatok)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Google (opcionális)
# NEXT_PUBLIC_GOOGLE_API_KEY=
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
