/**
 * Másold be a Firebase Console → Firestore → Rules szerkesztőbe.
 * Ez a legfontosabb védelem: a kliens SDK-t szabályokkal kell korlátozni.
 *
 * Admin = Auth e-mail == usezsolti@gmail.com
 * (később: custom claims admin == true)
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'usezsolti@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function emailLower() {
      return signedIn() ? request.auth.token.email.lower() : '';
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId)
        || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['assignedTasks', 'updatedAt']));
      allow delete: if isAdmin();

      // XP / badge / munkalap progress
      match /progress/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    match /bookings/{id} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.customerEmail.lower() == emailLower());
      // Bejelentkezve: saját e-mail. Vendég: pending + GDPR elfogadva.
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.keys().hasAll(['id', 'date', 'times', 'customerName', 'customerEmail'])
        && request.resource.data.customerEmail is string
        && request.resource.data.customerName is string
        && request.resource.data.date is string
        && (
          (signedIn() && request.resource.data.customerEmail.lower() == emailLower())
          || (!signedIn() && request.resource.data.gdprAccepted == true)
        );
      allow update: if isAdmin()
        || (signedIn()
            && resource.data.customerEmail.lower() == emailLower()
            && request.resource.data.status == 'cancelled'
            && resource.data.status in ['pending', 'approved']);
      allow delete: if isAdmin();
    }

    match /pendingBookings/{id} {
      allow read, write: if isAdmin();
    }

    match /approvedBookings/{id} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.customerEmail.lower() == emailLower());
      allow write: if isAdmin();
    }

    match /blockedSlots/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /assignedTasks/{id} {
      allow read: if isAdmin()
        || (signedIn() && (
              resource.data.studentId == request.auth.uid
              || resource.data.studentEmail.lower() == emailLower()
           ));
      allow create, update, delete: if isAdmin();
    }

    match /customTasks/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /publicTasks/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gameResults/{id} {
      allow read: if isAdmin()
        || (signedIn() && (
          resource.data.uid == request.auth.uid
          || resource.data.userId == request.auth.uid
        ));
      allow create: if signedIn() && (
        request.resource.data.uid == request.auth.uid
        || request.resource.data.userId == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    // ---- Közösség (Instagram-szerű) ----
    // Fontos: ezt a fájlt telepíteni kell a Firebase Console → Firestore → Rules alá!
    match /socialProfiles/{userId} {
      allow read: if signedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId)
        || (signedIn() && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'followerCount', 'followingCount', 'postCount',
                'xp', 'rank', 'displayName', 'photoURL',
                'updatedAt', 'updatedAtMs'
              ]));
      allow delete: if isAdmin();
    }

    match /follows/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.followingId is string;
      allow delete: if signedIn()
        && resource.data.followerId == request.auth.uid;
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.text is string;
      allow update: if signedIn() && (
        resource.data.authorId == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['likeCount', 'commentCount'])
      );
      allow delete: if isAdmin() || (signedIn() && resource.data.authorId == request.auth.uid);

      match /likes/{likeUid} {
        allow read: if signedIn();
        allow create, delete: if signedIn() && request.auth.uid == likeUid;
      }

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string;
        allow update: if false;
        allow delete: if isAdmin()
          || (signedIn() && resource.data.authorId == request.auth.uid);
      }
    }

    match /studyGroups/{groupId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn();
      allow delete: if isAdmin()
        || (signedIn() && resource.data.ownerId == request.auth.uid);
    }

    match /conversations/{conversationId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participants;
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid;
      }
    }

    match /mathShorts/{id} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    // Minden más: alapból tiltva
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
