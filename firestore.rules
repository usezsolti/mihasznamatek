/**
 * Másold be a Firebase Console → Firestore → Rules szerkesztőbe.
 * Ez a legfontosabb védelem: a kliens SDK-t szabályokkal kell korlátozni.
 *
 * Admin = csak usezsolti@gmail.com (pontos egyezés).
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function emailLower() {
      return signedIn() && request.auth.token.email is string
        ? request.auth.token.email.lower()
        : '';
    }
    function isAdmin() {
      return signedIn() && emailLower() == 'usezsolti@gmail.com';
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId)
        || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['assignedTasks', 'updatedAt', 'teacherAdmin']));
      allow delete: if isAdmin();

      // XP / badge / munkalap progress
      match /progress/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    match /bookings/{id} {
      // Query-barát szabály (customerEmail == auth.email)
      allow read: if isAdmin()
        || (signedIn() && resource.data.customerEmail == request.auth.token.email)
        || (signedIn() && resource.data.customerEmail.lower() == emailLower());
      // Tanár: óra felvétele a naptárba. Diák/vendég: pending + saját e-mail / GDPR.
      allow create: if isAdmin()
        || (
          request.resource.data.status == 'pending'
          && request.resource.data.keys().hasAll(['id', 'date', 'times', 'customerName', 'customerEmail'])
          && request.resource.data.customerEmail is string
          && request.resource.data.customerName is string
          && request.resource.data.date is string
          && (
            (signedIn() && request.resource.data.customerEmail.lower() == emailLower())
            || (!signedIn() && request.resource.data.gdprAccepted == true)
          )
        );
      allow update: if isAdmin()
        || (signedIn()
            && resource.data.customerEmail.lower() == emailLower()
            && request.resource.data.status == 'cancelled'
            && resource.data.status in ['pending', 'approved']);
      allow delete: if isAdmin();
    }

    match /pendingBookings/{id} {
      allow read, write: if isAdmin();
    }

    match /approvedBookings/{id} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.customerEmail.lower() == emailLower());
      allow write: if isAdmin();
    }

    match /whiteboards/{boardId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn();
      allow delete: if isAdmin()
        || (signedIn() && resource.data.createdBy == request.auth.uid);

      match /strokes/{strokeId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if isAdmin()
          || (signedIn() && resource.data.authorId == request.auth.uid);
      }
    }

    // Élő óra — nyílt link: bejelentkezett bárki olvashat / cseveghet
    match /lessonRooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.keys().hasAll(['title', 'createdBy', 'whiteboardId', 'jitsiRoom', 'createdAtMs']);
      allow update: if isAdmin()
        || (signedIn() && resource.data.createdBy == request.auth.uid);
      allow delete: if isAdmin()
        || (signedIn() && resource.data.createdBy == request.auth.uid);

      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;
      }

      match /callParticipants/{peerId} {
        allow read: if signedIn();
        allow create, update: if signedIn() && request.auth.uid == peerId;
        allow delete: if signedIn()
          && (request.auth.uid == peerId || isAdmin());
      }

      match /callSignals/{signalId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.type in ['offer', 'answer', 'ice', 'hangup'];
        allow delete: if signedIn()
          && (resource.data.fromUid == request.auth.uid || isAdmin());
      }
    }

    match /blockedSlots/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /assignedTasks/{id} {
      // Query-barát: studentId == auth.uid / studentEmail == auth.email
      allow read: if isAdmin()
        || (signedIn() && resource.data.studentId == request.auth.uid)
        || (signedIn() && resource.data.studentEmail == request.auth.token.email)
        || (signedIn() && resource.data.studentEmail.lower() == emailLower());
      allow create, update, delete: if isAdmin();
    }

    match /customTasks/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /publicTasks/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gameResults/{id} {
      allow read: if isAdmin()
        || (signedIn() && (
          resource.data.uid == request.auth.uid
          || resource.data.userId == request.auth.uid
        ));
      allow create: if signedIn() && (
        request.resource.data.uid == request.auth.uid
        || request.resource.data.userId == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    // ---- Közösség (Instagram-szerű) ----
    // TELEPÍTSD: Firebase Console → Firestore → Rules → Publish (firestore.rules)
    match /socialProfiles/{userId} {
      allow read: if signedIn();
      allow create: if isOwner(userId);
      // Számlálók is csak owner / backend (Admin) — ne lehessen más XP/név/countert bűvölni
      allow update: if isOwner(userId);
      allow delete: if isAdmin();
    }

    match /follows/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.followingId is string
        && request.resource.data.followingId != request.auth.uid;
      allow delete: if signedIn()
        && resource.data.followerId == request.auth.uid;
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.text is string;
      allow update: if signedIn() && resource.data.authorId == request.auth.uid;
      allow delete: if isAdmin() || (signedIn() && resource.data.authorId == request.auth.uid);

      match /likes/{likeUid} {
        allow read: if signedIn();
        allow create, delete: if signedIn() && request.auth.uid == likeUid;
      }

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string;
        allow update: if false;
        allow delete: if isAdmin()
          || (signedIn() && resource.data.authorId == request.auth.uid);
      }
    }

    match /studyGroups/{groupId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;
      // Owner teljes update; tag: join/leave VAGY whiteboardId csatolás
      allow update: if signedIn() && (
        resource.data.ownerId == request.auth.uid
        || (
          request.auth.uid in resource.data.memberIds
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['whiteboardId'])
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['memberIds', 'memberCount'])
          && (
            (
              !(request.auth.uid in resource.data.memberIds)
              && request.auth.uid in request.resource.data.memberIds
              && request.resource.data.memberCount == resource.data.memberCount + 1
            )
            || (
              request.auth.uid in resource.data.memberIds
              && !(request.auth.uid in request.resource.data.memberIds)
              && request.resource.data.memberCount == resource.data.memberCount - 1
              && resource.data.ownerId != request.auth.uid
            )
          )
        )
      );
      allow delete: if isAdmin()
        || (signedIn() && resource.data.ownerId == request.auth.uid);

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/studyGroups/$(groupId)).data.memberIds;
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/studyGroups/$(groupId)).data.memberIds;
      }
    }

    match /conversations/{conversationId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participants;
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastMessage', 'updatedAtMs', 'updatedAt', 'meta']);

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      }
    }

    match /mathShorts/{id} {
      allow read: if signedIn();
      allow create: if isAdmin()
        || (signedIn()
            && request.resource.data.authorId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Tanári órajegyzetek diákokhoz
    match /teacherNotes/{studentId} {
      allow read: if isAdmin() || isOwner(studentId);
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Minden más: alapból tiltva
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
